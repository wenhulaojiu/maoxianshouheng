  "finale": true,
  "hintTasks": [
    {
      "requires": [
        "aExitLatch"
      ],
      "hints": [
        "先看A区简图与两块小口压板。",
        "两半球压板，高处锁扣和侧缝门闩一起留住宽路。",
        "剪一球分压A/B槽；煤球踩汤圆背开高锁，奶盖开侧门。宽路固定后，在安全点旁按材料滑道，把两半一起送到织线机，不必逐个往返。"
      ]
    },
    {
      "requires": [
        "lightHigh"
      ],
      "hints": [
        "B区先点亮猫架上的应急灯。",
        "空手煤球能从低架起跳到第一盏灯。",
        "煤球放球，在B区灯架左侧跳上去，灯旁按E。亮区会保留。"
      ]
    },
    {
      "requires": [
        "lightLow"
      ],
      "hints": [
        "低处还有一盏被毛巾遮住的灯。",
        "奶盖空手走低路；先移毛巾再点灯。",
        "空手奶盖到低灯旁按E，会一起拉开毛巾并点灯；也能先单独移开毛巾。"
      ]
    },
    {
      "requires": [
        "bInnerBrace"
      ],
      "hints": [
        "B区需要运输连接和重4球。",
        "两半织绳固定滑轮；一个整球入水变毡球压重板。",
        "用滑道把两半送来织绳；A区旁还有整球接力口，可把起点散球送到滑轮。汤圆送毡球上重板，奶盖撑门。"
      ]
    },
    {
      "requires": [
        "vacuumOff"
      ],
      "hints": [
        "C区先看吸口旁的纸屑预告。",
        "煤球空手上高路关吸力，奶盖开尘盒可回收原球。",
        "保存安全点B后，煤球空手跳高台按E关吸尘器，再取旁边唯一散线。Q能驱离偷球鼠。"
      ]
    },
    {
      "requires": [
        "finalDivider"
      ],
      "hints": [
        "最后狗门有三种通过方式。",
        "整球或免费假球作诱饵；也可让奶盖沿高侧路开门。",
        "选诱饵槽或侧路，先开门再锁安全隔板；原球诱饵可在内侧取回，最后三猫进窝。"
      ]
    }
  ],
  "hints": [
    "A区先看简图：一球剪两半，分别压住两个轻板，再用高处锁扣和侧缝门闩开短廊。",
    "B区点两盏应急灯，把两半织成绳，固定滑轮，送一个整球进水盆变成毡球压重板。",
    "C区先观察吸尘器预告；尘盒可取回球，最后可用整球/假球诱饵，或走高路和侧门慢路线。"
  ],
