    {
      "requires": [
        "catTree"
      ],
      "hints": [
        "观察控制台和外圈托架。",
        "外圈送猫，内筒变毡，是两套用途。",
        "煤球空手跳控制架，按E启用外圈；上、下层拉绳都能暂停。"
      ]
    },
    {
      "requires": [
        "unload"
      ],
      "hints": [
        "观察出料上层和下层标志。",
        "错档只回地面低槽，不删除线球。",
        "奶盖钻维修缝，按出料挡板选好上层；汤圆装入整球就会自动洗线。外圈托架可单独暂停。"
      ]
    },
    {
      "requires": [
        "wideStairs"
      ],
      "hints": [
        "观察上层重板与折叠梯。",
        "毡球重4压板后，宽梯可以锁存。",
        "毡球到上层重板后，可在地面出料口拉绳放回程坡；也可让上层队友放坡。柜顶散线与中途停靠是可选挑战。"
      ]
    }
  ],
  "hints": [
    "煤球到控制台按 E 启动外圈托架；站上托架会被送到上层。",
    "把一颗整球放入内筒，启动短循环让它毡化；奶盖调整出料方向。",
    "用毡球压住4点重板，再展开宽梯，地面和上层都能下车。"
  ],
